# ============================================================================
# 博客部署配置文件示例
# ============================================================================
#
# 复制此文件为 deploy-config.toml 并根据需要修改配置
# 所有配置项都可通过环境变量覆盖
#
# 优先级：环境变量 > 配置文件 > 脚本默认值

# ============================================================================
# 路径配置
# ============================================================================

# Obsidian 笔记存放路径（源）
source = "/Users/xiuhao/Library/Mobile Documents/iCloud~md~obsidian/Documents/个人/posts"

# Hugo 内容目录（目标）
destination = "content/posts"

# Hugo 项目根目录
hugo_dir = "."

# Hugo 构建输出目录（通常是 public）
public_dir = "public"


# ============================================================================
# Git 配置
# ============================================================================

# 远程仓库地址
git_remote = "git@github.com:whistleditty/whistleditty.github.io.git"

# 主分支名称（默认：main）
main_branch = "main"

# Hostinger 部署分支名称
hostinger_branch = "hostinger"


# ============================================================================
# 部署配置
# ============================================================================

# 是否启用 Hostinger 部署
enable_hostinger = true

# 如果文件未变更，是否跳过构建
skip_if_no_changes = true


# ============================================================================
# Hugo 配置
# ============================================================================

# Hugo 环境：production 或 development
hugo_env = "production"


# ============================================================================
# 使用示例
# ============================================================================
#
# 1. 复制配置文件：
#    cp deploy-config.toml.example deploy-config.toml
#
# 2. 修改需要的配置项
#
# 3. 使用配置运行：
#    ./deploy.sh
#
# 4. 使用环境变量覆盖（优先级更高）：
#    DEPLOY_SOURCE_PATH="/other/path" ./deploy.sh --dry-run
#
# 5. 预览操作（不实际执行）：
#    ./deploy.sh --dry-run
#
# 6. 显示详细日志：
#    ./deploy.sh --verbose
#
# 7. 仅构建不部署：
#    ./deploy.sh --build-only
#
# 8. 跳过 Hostinger 部署：
#    ./deploy.sh --skip-hostinger
#
# 9. 仅同步文件（跳过 Git 和部署）：
#    ./deploy.sh --skip-git

